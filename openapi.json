{
  "openapi": "3.1.0",
  "info": {
    "title": "Urja Meter API",
    "version": "0.1.0",
    "description": "A clean, read-only REST API over the legacy **Urja Meter Ops** portal.\n\n* Fleet data (meters, network hierarchy, transformers) is served from a local snapshot built from the portal's bulk export and refreshed in the background. Responses carry `X-Snapshot-Age` (seconds). If the portal is down, the last good snapshot keeps being served.\n* Consumption is fetched live from the portal per meter and cached briefly.\n* Known data problems in the portal are repaired where safe, flagged per meter in `quality_flags`, and listed at `GET /data-quality`.\n\nAll JSON is snake_case; enums are lower-case slugs; timestamps are ISO-8601 with offset. Errors are always `{\"error\",\"message\"}`."
  },
  "paths": {
    "/meters": {
      "get": {
        "summary": "Search and filter meters",
        "tags": [
          "Meters"
        ],
        "operationId": "get_meters",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Substring of meter id or serial number.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "installed",
                "faulty",
                "decommissioned"
              ]
            }
          },
          {
            "name": "make",
            "in": "query",
            "required": false,
            "description": "Case-insensitive, e.g. 'l&t'.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "phase_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "single",
                "three"
              ]
            }
          },
          {
            "name": "install_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "whole_current",
                "ct_operated"
              ]
            }
          },
          {
            "name": "zone",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "circle",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "division",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "subdivision",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "substation",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "feeder",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "dt",
            "in": "query",
            "required": false,
            "description": "DT code, e.g. DT-007.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": false,
            "description": "Hierarchy path (from /hierarchy) to restrict to a subtree. Prefer this to the per-level codes, which repeat under different parents.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "quality_flag",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "hierarchy_repaired",
                "hierarchy_incomplete",
                "dt_name_conflict",
                "location_missing",
                "record_rejected"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "default": 1,
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Meter"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "page": {
                      "type": "integer"
                    },
                    "page_size": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "items",
                    "total",
                    "page",
                    "page_size"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "422": {
            "description": "Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "502": {
            "description": "The portal behaved unexpectedly or rejected our login",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The portal is unavailable; see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
