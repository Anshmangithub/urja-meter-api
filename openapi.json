  "components": {
    "schemas": {
      "Consumption": {
        "type": "object",
        "properties": {
          "meter_id": {
            "type": "string"
          },
          "interval_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Detected reading cadence (median spacing). 30 or 1440 in practice; null with fewer than two readings."
          },
          "count": {
            "type": "integer"
          },
          "readings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnergyReading"
            }
          },
          "summary": {
            "$ref": "#/components/schemas/EnergySummary"
          }
        },
        "required": [
          "meter_id",
          "interval_minutes",
          "count",
          "readings",
          "summary"
        ],
        "additionalProperties": false
      },
      "DataQualityIssue": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "hierarchy_repaired",
              "hierarchy_incomplete",
              "dt_name_conflict",
              "location_missing",
              "record_rejected"
            ]
          },
          "meter_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "meter_id",
          "detail"
        ],
        "additionalProperties": false
      },
      "DataQualityReport": {
        "type": "object",
        "properties": {
          "snapshot": {
            "$ref": "#/components/schemas/SnapshotInfo"
          },
          "meter_count": {
            "type": "integer"
          },
          "counts": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "hierarchy_repaired",
                "hierarchy_incomplete",
                "dt_name_conflict",
                "location_missing",
                "record_rejected"
              ]
            },
            "additionalProperties": {
              "type": "integer"
            },
            "required": [
              "hierarchy_repaired",
              "hierarchy_incomplete",
              "dt_name_conflict",
              "location_missing",
              "record_rejected"
            ]
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DataQualityIssue"
            }
          }
        },
        "required": [
          "snapshot",
          "meter_count",
          "counts",
          "issues"
        ],
        "additionalProperties": false
      },
      "EnergyReading": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
