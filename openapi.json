    "/meters/{meter_id}/consumption": {
      "get": {
        "summary": "Meter readings with derived per-interval consumption",
        "tags": [
          "Meters"
        ],
        "operationId": "get_meters_meter_id_consumption",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "First day, inclusive (YYYY-MM-DD). Omit both bounds for the portal's default window (about the last 7 days of available data).",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Last day, inclusive (YYYY-MM-DD).",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Consumption"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
